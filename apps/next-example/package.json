{
  "name": "@hods/next-example",
  "version": "0.5.2",
  "description": "A Next.js application with HODS components.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run test:unit",
    "test:ci": "npm test && npm run test:functional:ci",
    "test:functional": "PLAYWRIGHT_PROJECT=next-example ../../node_modules/.bin/playwright test --config=../../playwright.config.ts --project=next-example",
    "test:functional:ci": "npm run test:functional",
    "test:unit": "jest --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hods/components": "^0.5.2",
    "@not-govuk/simple-components": "^0.16.3",
    "next": "15.4.10",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "sass": "^1.80.6",
    "ts-jest": "29.2.5",
    "typescript": "^5"
  }
}
