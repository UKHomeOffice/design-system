{
  "scripts": {
    "create": "plop",
    "create:app": "plop app",
    "create:component": "plop component",
    "create:lib": "plop lib",
    "all:build": "npm run build --workspaces --if-present",
    "all:clean": "npm run clean --workspaces --if-present",
    "all:publish": "npm run libs:publish",
    "apps:build": "npm run build --workspace=apps --if-present",
    "apps:clean": "npm run clean --workspace=apps --if-present",
    "libs:build": "npm run build --workspace=components --workspace=lib --if-present",
    "libs:clean": "npm run clean --workspace=components --workspace=lib --if-present",
    "libs:publish": "npm publish --workspace=components --workspace=lib --access public",
    "build": "npm run build:storybook",
    "clean": "npm run clean:storybook",
    "preversion": "echo 'Warning: This should only be done on a fresh branch from master.'",
    "version": "bash .npm/version.sh",
    "postversion": "echo 'Done. You should now publish (with `npm run all:publish`), push your branch, push your tags and merge to master.'",
    "postinstall": "patch-package",
    "distclean": "find apps components lib -name node_modules -type d -prune -exec rm -rf {} + && rm -rf node_modules",
    "start": "echo 'Error: This is the root of the monorepo, you should run `cd apps/YOUR_APP && npm start` or run `npm run storybook` to start Storybook.' && false",
    "storybook": "start-storybook -p 9009",
    "build:storybook": "build-storybook",
    "clean:storybook": "rm -rf storybook-static",
    "test:visual": "npm run build:storybook && playwright test --project=visual",
    "test:visual:update": "npm run build:storybook && playwright test --project=visual --update-snapshots",
    "test": "jest --coverage --json --outputFile=.jest-results.json"
  },
  "devDependencies": {
    "@apollo/client": "3.11.9",
    "@babel/core": "7.26.0",
    "@babel/plugin-proposal-export-namespace-from": "7.18.9",
    "@babel/preset-env": "7.26.0",
    "@babel/preset-react": "7.25.9",
    "@babel/preset-typescript": "7.26.0",
    "@hods/components": "^0.5.2",
    "@hods/plop-pack": "^0.5.2",
    "@mdx-js/react": "1.6.22",
    "@not-govuk/components": "^0.16.3",
    "@not-govuk/docs-components": "^0.16.3",
    "@not-govuk/storybook-preset": "^0.16.3",
    "@not-govuk/user-info": "^0.16.3",
    "@playwright/test": "1.51.1",
    "@storybook/addon-a11y": "6.5.16",
    "@storybook/addon-actions": "6.5.16",
    "@storybook/addon-docs": "6.5.16",
    "@storybook/addon-jest": "6.5.16",
    "@storybook/addon-links": "6.5.16",
    "@storybook/addon-storysource": "6.5.16",
    "@storybook/addon-viewport": "6.5.16",
    "@storybook/addons": "6.5.16",
    "@storybook/builder-webpack5": "6.5.16",
    "@storybook/manager-webpack5": "6.5.16",
    "@storybook/react": "6.5.16",
    "@storybook/theming": "6.5.16",
    "@types/jest": "29.5.14",
    "@types/react": "^18.3.12",
    "@types/webpack-env": "1.18.5",
    "ajv": "^8.20.0",
    "babel-jest": "29.7.0",
    "babel-plugin-transform-class-properties": "6.24.1",
    "http-server": "14.1.1",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "patch-package": "^8.0.0",
    "plop": "4.0.1",
    "process": "^0.11.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet-async": "2.0.5",
    "react-router": "6.30.4",
    "react-router-dom": "6.30.4",
    "ts-jest": "29.2.5",
    "typescript": "4.9.5",
    "webpack": "5.96.1",
    "webpack-cli": "5.1.4",
    "webpack-dev-middleware": "6.1.3",
    "webpack-hot-middleware": "2.26.1"
  },
  "name": "hods",
  "version": "0.5.2",
  "description": "The design system for the UK Home Office.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UKHomeOffice/design-system.git"
  },
